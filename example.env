# =====================================================================
# WhatsApp Portal — environment template
# Copy to .env and fill the values. NEVER commit the real .env.
#   cp example.env .env
# =====================================================================

# ---- Application ----------------------------------------------------
# Generate a fresh one per deploy:  openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
# development | production
ENVIRONMENT=development

# ---- Database (Postgres) --------------------------------------------
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me_long_password
POSTGRES_DB=portal
# Must match POSTGRES_USER/PASSWORD above. Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://portal:change_me_long_password@postgres:5432/portal

# ---- Redis ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Evolution API --------------------------------------------------
EVOLUTION_API_KEY=change_me_long_password
# Inside docker-compose, reach Evolution by its service name:
EVOLUTION_BASE_URL=http://evolution:8080
# URL Evolution uses to call back INTO this backend (reachable from the
# Evolution container). With docker-compose the backend service name works.
PUBLIC_BACKEND_URL=http://backend:8000

# ---- CORS -----------------------------------------------------------
# CSV (or JSON list) of every origin the browser uses to reach the portal.
# In prod include the real host, e.g. http://10.0.0.42:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Frontend (Next.js) ---------------------------------------------
# IMPORTANT: inlined into the client bundle at BUILD time. In prod set these
# to the VM's real reachable address BEFORE building, never localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
